# Complemento para a configuração de homologação existente em docker/dev.
# Defaults seguros: nenhuma API externa nem simulação ativada automaticamente.
CHANNELS_NETWORK_ENABLED=0
CHANNELS_LIVE_ENABLED=0
CHANNELS_SIMULATOR_ENABLED=0
# Somente credenciais do APLICATIVO DE TESTE autorizado pelo iFood.
IFOOD_TEST_CLIENT_ID=
IFOOD_TEST_CLIENT_SECRET=
# Não preencher nesta etapa. Exigem homologação e autorização de produção.
IFOOD_LIVE_CLIENT_ID=
IFOOD_LIVE_CLIENT_SECRET=
# A criptografia reutiliza SECRET_KEY existente. Preserve-a e faça backup seguro.
# 99Food: nenhuma variável de endpoint/segredo inventada; contrato ainda bloqueado.
