# ==========================================================================
# Exemplo de variáveis de ambiente — Delivery White-label
# --------------------------------------------------------------------------
# Copie este arquivo para `.env` e ajuste os valores conforme o seu ambiente.
#
#   cp .env.example .env
#
# Para rodar com Docker Compose, coloque o `.env` na mesma pasta do
# docker-compose.yml (ex.: docker/dev/.env ou docker/prod/.env).
# ==========================================================================

# --- Django -----------------------------------------------------------------
# Módulo de configuração:
#   config.settings.dev   -> desenvolvimento (DEBUG=True)
#   config.settings.prod  -> produção (DEBUG=False, segurança reforçada)
DJANGO_SETTINGS_MODULE=config.settings.dev

# Chave secreta do Django. GERE UMA NOVA e mantenha em segredo.
# Você pode gerar uma com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=troque-esta-chave-por-uma-aleatoria-e-secreta

# Hosts permitidos (separados por vírgula). Ex.: meudominio.com,www.meudominio.com
ALLOWED_HOSTS=localhost,127.0.0.1
TENANT_BASE_DOMAIN=lvh.me
TENANT_PUBLIC_SCHEME=https
CUSTOMER_PORTAL_URL=https://lvh.me

# --- Banco de dados (PostgreSQL) --------------------------------------------
POSTGRES_DB=delivery
POSTGRES_USER=delivery
POSTGRES_PASSWORD=troque-esta-senha
DATABASE_HOST=db
DATABASE_PORT=5432

# --- Redis / Celery ---------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# --- Gunicorn (produção) ----------------------------------------------------
PORT=8000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# --- Entrypoint (Docker) ----------------------------------------------------
# Rodar migrações automaticamente ao subir o container web (true/false)
RUN_MIGRATIONS=true
# Coletar arquivos estáticos ao subir o container web (true/false)
COLLECTSTATIC=true

# --- Cookies de sessão (produção, multi-tenant por subdomínio) --------------
# Domínio compartilhado entre subdomínios (opcional). Ex.: .meudominio.com
SESSION_COOKIE_DOMAIN=

# Evolution API / validação de WhatsApp
EVOLUTION_WHATSAPP_VALIDATION_ENABLED=false
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_API_TIMEOUT=4
EVOLUTION_CHECK_CACHE_SECONDS=86400

# Pacote 8: true apenas com acesso ao Django restrito ao Nginx confiável.
OTP_TRUST_PROXY_HEADERS=false
# OTP WhatsApp exige EVOLUTION_API_URL, EVOLUTION_API_KEY e EVOLUTION_INSTANCE.
# EVOLUTION_WHATSAPP_VALIDATION_ENABLED controla somente a consulta de existência.
