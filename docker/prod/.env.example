# ============================================================================
# VemDeDelivery — PRODUÇÃO
# Copie para docker/prod/.env e substitua TODOS os valores marcados TROQUE.
# Nunca versione o arquivo .env real.
# ============================================================================

DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=TROQUE-POR-UMA-CHAVE-SECRETA-FORTE

# Domínio principal + wildcard dos tenants
ALLOWED_HOSTS=vemdedelivery.com.br,.vemdedelivery.com.br
SESSION_COOKIE_DOMAIN=.vemdedelivery.com.br
CSRF_TRUSTED_ORIGINS=https://vemdedelivery.com.br,https://*.vemdedelivery.com.br
CUSTOMER_PORTAL_URL=https://vemdedelivery.com.br

# Hardening definido no Pacote 1
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=3600

# PostgreSQL
POSTGRES_DB=delivery
POSTGRES_USER=delivery
POSTGRES_PASSWORD=TROQUE-POR-UMA-SENHA-FORTE
DATABASE_HOST=db
DATABASE_PORT=5432

# Redis / Celery / cache compartilhado
REDIS_URL=redis://redis:6379/0
CACHE_REDIS_URL=redis://redis:6379/1
REDIS_HOST=redis
REDIS_PORT=6379

# Gunicorn
PORT=8000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100

# Bootstrap do container web
RUN_MIGRATIONS=true
COLLECTSTATIC=true

# APIs externas já usadas pelo projeto, se aplicável
# MARKETPLACE_GEOCODER_USER_AGENT=VemDeDelivery/1.0

# Observabilidade
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=WARNING

# Sentry (opcional). Deixe vazio para manter desabilitado.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05

# E-mail / recuperação de senha
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=VemDeDelivery <no-reply@vemdedelivery.com.br>
PASSWORD_RESET_TIMEOUT=3600


# Evolution API / validação de WhatsApp
EVOLUTION_WHATSAPP_VALIDATION_ENABLED=false
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_API_TIMEOUT=4
EVOLUTION_CHECK_CACHE_SECONDS=86400

# Asaas / cobrança da plataforma. Mantenha false até a ativação controlada.
BILLING_ENABLED=false
ASAAS_ENVIRONMENT=production
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_WEBHOOK_URL=https://vemdedelivery.com.br/integracoes/asaas/webhook/

# NFS-e / autenticação municipal dinâmica. Preencha SOMENTE o método
# retornado por GET /fiscalInfo/municipalOptions. Nunca versione segredos.
# CERTIFICATE
ASAAS_FISCAL_CERT_PATH=/app/.secrets/asaas-a1.pfx
ASAAS_FISCAL_CERT_PASSWORD=
# USER_AND_PASSWORD
ASAAS_FISCAL_USERNAME=
ASAAS_FISCAL_PASSWORD=
# TOKEN
ASAAS_FISCAL_ACCESS_TOKEN=

# Alertas administrativos mensais de ISS (Pacote 10.2)
SUPERADMIN_PUBLIC_URL=https://vemdedelivery.com.br
CONTABILIZEI_TAX_RATES_URL=https://app.contabilizei.com.br/painel-de-controle/#/minhas-aliquotas
