# Comece desabilitado. Habilite depois de configurar e testar.
BILLING_ENABLED=false
# homolog: sandbox; prod: production. Não use sandbox na aplicação de produção.
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
# Token do webhook, DIFERENTE da chave de API. Use pelo menos 32 caracteres aleatórios.
ASAAS_WEBHOOK_TOKEN=
