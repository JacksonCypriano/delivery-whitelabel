# ============================================================================
# VemDeDelivery — PRODUÇÃO
# Copie para docker/prod/.env e substitua TODOS os valores marcados TROQUE.
# Nunca versione o arquivo .env real.
# ============================================================================

DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=TROQUE-POR-UMA-CHAVE-SECRETA-FORTE

# Domínio principal + wildcard dos tenants
ALLOWED_HOSTS=vemdedelivery.com.br,.vemdedelivery.com.br
SESSION_COOKIE_DOMAIN=.vemdedelivery.com.br
CSRF_TRUSTED_ORIGINS=https://vemdedelivery.com.br,https://*.vemdedelivery.com.br
CUSTOMER_PORTAL_URL=https://vemdedelivery.com.br

# Hardening definido no Pacote 1
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=3600

# PostgreSQL
POSTGRES_DB=delivery
POSTGRES_USER=delivery
POSTGRES_PASSWORD=TROQUE-POR-UMA-SENHA-FORTE
DATABASE_HOST=db
DATABASE_PORT=5432

# Redis / Celery / cache compartilhado
REDIS_URL=redis://redis:6379/0
CACHE_REDIS_URL=redis://redis:6379/1
REDIS_HOST=redis
REDIS_PORT=6379

# Gunicorn
PORT=8000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100

# Bootstrap do container web
RUN_MIGRATIONS=true
COLLECTSTATIC=true

# APIs externas já usadas pelo projeto, se aplicável
# MARKETPLACE_GEOCODER_USER_AGENT=VemDeDelivery/1.0

# Observabilidade
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=WARNING

# Sentry (opcional). Deixe vazio para manter desabilitado.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05

